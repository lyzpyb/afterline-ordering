STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_APP_URL=https://aiorderafterline.shop

# Production deployment example:
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_live_xxx

# Stable Stripe Price per plan: STRIPE_PRICE_<PLANID>_<LIVE|TEST>.
# The mode suffix follows STRIPE_SECRET_KEY (sk_live_ -> LIVE, otherwise TEST).
# When a price is unset, checkout falls back to an inline price built from
# src/lib/test-plans.ts in that plan's currency.
# Mexico (MXN)
# STRIPE_PRICE_WEEKLY_LIVE=price_xxx
# STRIPE_PRICE_WEEKLY_DISCOUNT_LIVE=price_xxx
# STRIPE_PRICE_MONTHLY_LIVE=price_xxx
# STRIPE_PRICE_ANNUAL_LIVE=price_xxx
# United States (USD)
# STRIPE_PRICE_US_WEEKLY_LIVE=price_xxx
# STRIPE_PRICE_US_WEEKLY_DISCOUNT_LIVE=price_xxx
# STRIPE_PRICE_US_MONTHLY_LIVE=price_xxx
# STRIPE_PRICE_US_ANNUAL_LIVE=price_xxx
# Brazil (USD)
# STRIPE_PRICE_BR_WEEKLY_LIVE=price_xxx
# STRIPE_PRICE_BR_WEEKLY_DISCOUNT_LIVE=price_xxx
# STRIPE_PRICE_BR_MONTHLY_LIVE=price_xxx
# STRIPE_PRICE_BR_ANNUAL_LIVE=price_xxx
# (repeat with _TEST for Stripe test mode)

# Stripe Product recorded on billing_subscriptions for the new subscription
# plans: STRIPE_PRODUCT_<PLANID>_<LIVE|TEST>. The MX monthly/annual products are
# built in. When unset, the product on the Stripe subscription item is used.
# STRIPE_PRODUCT_US_MONTHLY_LIVE=prod_xxx
# STRIPE_PRODUCT_US_ANNUAL_LIVE=prod_xxx
# STRIPE_PRODUCT_BR_MONTHLY_LIVE=prod_xxx
# STRIPE_PRODUCT_BR_ANNUAL_LIVE=prod_xxx

# Optional region lock. When "true", a buyer whose x-vercel-ip-country is one of
# AFTERLINE_CHARGEABLE_MARKETS is refused (403) a plan from a different market.
# While it is off, planId alone decides the price. Before turning it on, follow
# "Rolling out US and BR" in README.md (the webapp's geo must be confirmed).
# ENFORCE_MARKET_BY_IP=false
# Same value as the AfterLine webapp's BILLING_CHARGEABLE_MARKETS (default MX).
# AFTERLINE_CHARGEABLE_MARKETS=MX
